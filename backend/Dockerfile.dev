# LỖ HỔNG ĐƯỢC VÁ: Đồng nhất Python 3.12-slim với Production để tránh Environment Schizophrenia
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
# LỖ HỔNG ĐƯỢC VÁ: Bắt buộc dùng Lockfile có Hash để an toàn như Production
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

# Copy application code
COPY ./app ./app
COPY ./alembic ./alembic
COPY alembic.ini .
COPY ./tests ./tests

# Expose the port the app runs on
EXPOSE 8000

# LỖ HỔNG ĐƯỢC VÁ: Bổ sung --reload để kích hoạt Hot-Reloading khi code thay đổi qua volume mount
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]